# Copie para .env. Nunca publique suas chaves.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FISH_API_KEY=
# ID da voz; diferente do modelo de síntese.
FISH_REFERENCE_ID=
# Informe somente um modelo liberado na SUA conta; não há seleção paga implícita.
FISH_MODEL=s2.1-pro-free
CRONOS_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Windows: C:/Users/SEU_USUARIO/Documents/Cronos
CRONOS_VAULT=./vault
CRONOS_PERSONALITY=./modelos/personalidades/cronos.md
# Gere uma chave local. Exigida por todas as rotas de dados.
CRONOS_API_TOKEN=
# Origin exata da sua interface; deixe vazio até conectar a interface.
CRONOS_CORS_ORIGINS=
# Provedores adicionais: copie config/providers.example.json e edite o manifesto.
CRONOS_PROVIDERS_FILE=./config/providers.json
# Orçamentos de contexto; não apagam nem truncam a memória armazenada.
CRONOS_CONTEXT_MESSAGES=40
CRONOS_CONTEXT_CHARS=48000
CRONOS_MEMORY_CHARS=16000
CRONOS_MEMORY_RESULTS=8
CRONOS_TOOL_ROUNDS=6
# Arquivos que o assistente pode consultar/manipular; escolha a raiz explicitamente.
CRONOS_FILES_ROOT=
FISH_SPEED=1.0
FISH_LATENCY=balanced
# Plugins instalados são código local com acesso ao processo, não uma sandbox.
CRONOS_ENABLE_PLUGINS=0
# Vazio: limite nativo de saída do modelo; ajuste conforme o provedor suporta.
CRONOS_OUTPUT_TOKENS=
CRONOS_PROVIDER_TIMEOUT=180
# online: APIs externas; local: somente Ollama no loopback, sem Fish/web/plugins.
CRONOS_PRIVACY_MODE=online
# Mesmo habilitado, executar .exe exige confirmação humana. Não é uma sandbox.
CRONOS_ALLOW_EXECUTABLES=0
