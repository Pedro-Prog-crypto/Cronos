# Copie para .env. Nunca publique suas chaves.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FISH_API_KEY=
# ID da voz; diferente do modelo de síntese.
FISH_REFERENCE_ID=
FISH_MODEL=s2-pro
CRONOS_PROVIDER=gemini
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
# Windows: C:/Users/SEU_USUARIO/Documents/Cronos
CRONOS_VAULT=./vault
CRONOS_PERSONALITY=./modelos/personalidades/cronos.md
# Gere uma chave local. Exigida por todas as rotas de dados.
CRONOS_API_TOKEN=
# Origin exata da sua interface; deixe vazio até conectar a interface.
CRONOS_CORS_ORIGINS=
